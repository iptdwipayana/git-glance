# Normalize to LF in the repo and on checkout, so the Windows host and the Linux
# Dev Container agree regardless of anyone's core.autocrlf setting.
* text=auto eol=lf

# Shell scripts must be LF — Husky hooks fail to execute with CRLF.
*.sh   text eol=lf
*.bash text eol=lf

# Windows scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated files — collapse in GitHub diffs and PR review.
pnpm-lock.yaml       text eol=lf linguist-generated=true
src/routeTree.gen.ts text eol=lf linguist-generated=true

# Better diff hunk headers.
*.md   text diff=markdown
*.css  text diff=css
*.html text diff=html

# Binary — never line-ending-converted, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf binary
*.zip binary
